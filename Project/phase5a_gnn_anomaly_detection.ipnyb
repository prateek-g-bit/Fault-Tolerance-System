{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":14637839,"sourceType":"datasetVersion","datasetId":9350761}],"dockerImageVersionId":31259,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:20.573843Z","iopub.execute_input":"2026-01-27T11:08:20.574171Z","iopub.status.idle":"2026-01-27T11:08:20.951874Z","shell.execute_reply.started":"2026-01-27T11:08:20.574138Z","shell.execute_reply":"2026-01-27T11:08:20.950827Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/faulty-5a/fault_times.json\n/kaggle/input/faulty-5a/adjacency.npy\n/kaggle/input/faulty-5a/synthetic_ground_truth_eval.csv\n/kaggle/input/faulty-5a/df_faulty_adv.csv\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:20.953018Z","iopub.execute_input":"2026-01-27T11:08:20.953533Z","iopub.status.idle":"2026-01-27T11:08:23.075138Z","shell.execute_reply.started":"2026-01-27T11:08:20.953503Z","shell.execute_reply":"2026-01-27T11:08:23.074304Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"df_faulty = pd.read_csv(\"/kaggle/input/faulty-5a/df_faulty_adv.csv\")\n\nA_norm = np.load(\"/kaggle/input/faulty-5a/adjacency.npy\")\nA = torch.tensor(A_norm, dtype=torch.float32)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.076165Z","iopub.execute_input":"2026-01-27T11:08:23.076551Z","iopub.status.idle":"2026-01-27T11:08:23.091931Z","shell.execute_reply.started":"2026-01-27T11:08:23.076523Z","shell.execute_reply":"2026-01-27T11:08:23.090744Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"NODE_IDS = [0, 1, 2, 3, 4, 101]\nNODE_TO_IDX = {n: i for i, n in enumerate(NODE_IDS)}\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.093312Z","iopub.execute_input":"2026-01-27T11:08:23.093756Z","iopub.status.idle":"2026-01-27T11:08:23.100100Z","shell.execute_reply.started":"2026-01-27T11:08:23.093717Z","shell.execute_reply":"2026-01-27T11:08:23.099210Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"df = df_faulty.copy()\ndf[\"theta_calib\"] = df[\"value\"]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.101019Z","iopub.execute_input":"2026-01-27T11:08:23.101281Z","iopub.status.idle":"2026-01-27T11:08:23.119833Z","shell.execute_reply.started":"2026-01-27T11:08:23.101255Z","shell.execute_reply":"2026-01-27T11:08:23.118880Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"probe_diff = (\n    df_faulty\n    .pivot_table(\n        index=[\"time_index\", \"sender\"],\n        columns=\"probe\",\n        values=\"value\"\n    )\n    .dropna()\n)\n\nprobe_diff[\"probe_disagreement\"] = (\n    probe_diff.iloc[:, 0] - probe_diff.iloc[:, 1]\n).abs()\n\nprobe_diff = probe_diff.reset_index()[[\n    \"time_index\", \"sender\", \"probe_disagreement\"\n]]\n\ndf = df.merge(\n    probe_diff,\n    on=[\"time_index\", \"sender\"],\n    how=\"left\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.121358Z","iopub.execute_input":"2026-01-27T11:08:23.121713Z","iopub.status.idle":"2026-01-27T11:08:23.154050Z","shell.execute_reply.started":"2026-01-27T11:08:23.121685Z","shell.execute_reply":"2026-01-27T11:08:23.152833Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"df = df.sort_values([\"sender\", \"time_index\"])\ndf[\"delta_theta\"] = (\n    df.groupby(\"sender\")[\"theta_calib\"]\n      .diff()\n      .fillna(0.0)\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.155282Z","iopub.execute_input":"2026-01-27T11:08:23.155556Z","iopub.status.idle":"2026-01-27T11:08:23.165054Z","shell.execute_reply.started":"2026-01-27T11:08:23.155524Z","shell.execute_reply":"2026-01-27T11:08:23.163976Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"FEATURE_COLUMNS = [\n    \"theta_calib\",\n    \"probe_disagreement\",\n    \"delta_theta\"\n]\n\ndf[FEATURE_COLUMNS] = df[FEATURE_COLUMNS].fillna(0.0)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.166238Z","iopub.execute_input":"2026-01-27T11:08:23.166711Z","iopub.status.idle":"2026-01-27T11:08:23.182301Z","shell.execute_reply.started":"2026-01-27T11:08:23.166682Z","shell.execute_reply":"2026-01-27T11:08:23.181175Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"def build_anomaly_snapshots(df, feature_cols):\n    snapshots = []\n\n    for t in sorted(df.time_index.unique()):\n        df_t = df[df.time_index == t]\n\n        x = torch.zeros((len(NODE_IDS), len(feature_cols)))\n\n        for _, row in df_t.iterrows():\n            idx = NODE_TO_IDX[row.sender]\n            x[idx] = torch.tensor(\n                row[feature_cols].to_numpy(dtype=np.float32),\n                dtype=torch.float32\n            )\n\n        snapshots.append({\n            \"time_index\": t,\n            \"x\": x\n        })\n\n    return snapshots\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.185501Z","iopub.execute_input":"2026-01-27T11:08:23.185821Z","iopub.status.idle":"2026-01-27T11:08:23.204066Z","shell.execute_reply.started":"2026-01-27T11:08:23.185793Z","shell.execute_reply":"2026-01-27T11:08:23.203059Z"}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"snapshots = build_anomaly_snapshots(df, FEATURE_COLUMNS)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.205225Z","iopub.execute_input":"2026-01-27T11:08:23.205541Z","iopub.status.idle":"2026-01-27T11:08:23.857999Z","shell.execute_reply.started":"2026-01-27T11:08:23.205514Z","shell.execute_reply":"2026-01-27T11:08:23.856848Z"}},"outputs":[],"execution_count":10},{"cell_type":"code","source":"class GraphAutoencoder(nn.Module):\n    def __init__(self, in_dim, hidden_dim=16, latent_dim=8):\n        super().__init__()\n\n        # Encoder\n        self.enc1 = nn.Linear(in_dim, hidden_dim)\n        self.enc2 = nn.Linear(hidden_dim, latent_dim)\n\n        # Decoder\n        self.dec1 = nn.Linear(latent_dim, hidden_dim)\n        self.dec2 = nn.Linear(hidden_dim, in_dim)\n\n    def forward(self, x, A):\n        # Graph aggregation\n        h = torch.matmul(A, x)\n\n        # Encode\n        h = F.relu(self.enc1(h))\n        z = self.enc2(h)\n\n        # Decode\n        h = F.relu(self.dec1(z))\n        x_hat = self.dec2(h)\n\n        return x_hat\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.859138Z","iopub.execute_input":"2026-01-27T11:08:23.859442Z","iopub.status.idle":"2026-01-27T11:08:23.866219Z","shell.execute_reply.started":"2026-01-27T11:08:23.859404Z","shell.execute_reply":"2026-01-27T11:08:23.865211Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"def train_autoencoder(model, snapshots, A, epochs=50, lr=1e-3):\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n    model.train()\n\n    for epoch in range(epochs):\n        losses = []\n\n        for snap in snapshots:\n            optimizer.zero_grad()\n\n            x = snap[\"x\"]\n            x_hat = model(x, A)\n\n            loss = F.mse_loss(x_hat, x)\n            loss.backward()\n            optimizer.step()\n\n            losses.append(loss.item())\n\n        if epoch % 10 == 0:\n            print(\n                f\"Epoch {epoch:03d} | Recon Loss: {np.mean(losses):.6f}\"\n            )\n\n    return model\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.867306Z","iopub.execute_input":"2026-01-27T11:08:23.867677Z","iopub.status.idle":"2026-01-27T11:08:23.883022Z","shell.execute_reply.started":"2026-01-27T11:08:23.867640Z","shell.execute_reply":"2026-01-27T11:08:23.881728Z"}},"outputs":[],"execution_count":12},{"cell_type":"code","source":"def compute_anomaly_scores(model, snapshots, A):\n    model.eval()\n    records = []\n\n    with torch.no_grad():\n        for snap in snapshots:\n            x = snap[\"x\"]\n            x_hat = model(x, A)\n\n            # L2 reconstruction error per node\n            error = torch.norm(x - x_hat, dim=1)\n\n            for i, node in enumerate(NODE_IDS):\n                records.append([\n                    snap[\"time_index\"],\n                    node,\n                    float(error[i])\n                ])\n\n    return pd.DataFrame(\n        records,\n        columns=[\"time_index\", \"sender\", \"anomaly_score\"]\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:09:12.001968Z","iopub.execute_input":"2026-01-27T11:09:12.002847Z","iopub.status.idle":"2026-01-27T11:09:12.009498Z","shell.execute_reply.started":"2026-01-27T11:09:12.002814Z","shell.execute_reply":"2026-01-27T11:09:12.008396Z"}},"outputs":[],"execution_count":16},{"cell_type":"code","source":"model_ae = GraphAutoencoder(\n    in_dim=len(FEATURE_COLUMNS)\n)\n\nmodel_ae = train_autoencoder(\n    model_ae,\n    snapshots,\n    A,\n    epochs=50,\n    lr=1e-3\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:23.905352Z","iopub.execute_input":"2026-01-27T11:08:23.905705Z","iopub.status.idle":"2026-01-27T11:08:37.385302Z","shell.execute_reply.started":"2026-01-27T11:08:23.905663Z","shell.execute_reply":"2026-01-27T11:08:37.384462Z"}},"outputs":[{"name":"stdout","text":"Epoch 000 | Recon Loss: 110.769201\nEpoch 010 | Recon Loss: 98.722355\nEpoch 020 | Recon Loss: 98.721679\nEpoch 030 | Recon Loss: 98.718917\nEpoch 040 | Recon Loss: 98.702570\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"with torch.no_grad():\n    x = snapshots[0][\"x\"]\n    x_hat = model_ae(x, A)\n\nprint(x.shape, x_hat.shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:08:37.386522Z","iopub.execute_input":"2026-01-27T11:08:37.386961Z","iopub.status.idle":"2026-01-27T11:08:37.393753Z","shell.execute_reply.started":"2026-01-27T11:08:37.386923Z","shell.execute_reply":"2026-01-27T11:08:37.392537Z"}},"outputs":[{"name":"stdout","text":"torch.Size([6, 3]) torch.Size([6, 3])\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"df_anomaly = compute_anomaly_scores(model_ae, snapshots, A)\ndf_anomaly.head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:09:29.511972Z","iopub.execute_input":"2026-01-27T11:09:29.512756Z","iopub.status.idle":"2026-01-27T11:09:29.566669Z","shell.execute_reply.started":"2026-01-27T11:09:29.512724Z","shell.execute_reply":"2026-01-27T11:09:29.565555Z"}},"outputs":[{"execution_count":17,"output_type":"execute_result","data":{"text/plain":"   time_index  sender  anomaly_score\n0           0       0      16.508188\n1           0       1       7.932333\n2           0       2       7.932333\n3           0       3      15.310901\n4           0       4       7.932333","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>time_index</th>\n      <th>sender</th>\n      <th>anomaly_score</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0</td>\n      <td>0</td>\n      <td>16.508188</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>0</td>\n      <td>1</td>\n      <td>7.932333</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>0</td>\n      <td>2</td>\n      <td>7.932333</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>0</td>\n      <td>3</td>\n      <td>15.310901</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>0</td>\n      <td>4</td>\n      <td>7.932333</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":17},{"cell_type":"code","source":"import json\n\nwith open(\"/kaggle/input/faulty-5a/fault_times.json\") as f:\n    fault_times = set(json.load(f))\n\ndf_anomaly[\"fault\"] = (\n    (df_anomaly.time_index.isin(fault_times)) &\n    (df_anomaly.sender == 2)\n).astype(int)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:09:57.074156Z","iopub.execute_input":"2026-01-27T11:09:57.075199Z","iopub.status.idle":"2026-01-27T11:09:57.086810Z","shell.execute_reply.started":"2026-01-27T11:09:57.075142Z","shell.execute_reply":"2026-01-27T11:09:57.085740Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"df_anomaly.fault.value_counts()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:10:04.883122Z","iopub.execute_input":"2026-01-27T11:10:04.883479Z","iopub.status.idle":"2026-01-27T11:10:04.892753Z","shell.execute_reply.started":"2026-01-27T11:10:04.883450Z","shell.execute_reply":"2026-01-27T11:10:04.891611Z"}},"outputs":[{"execution_count":19,"output_type":"execute_result","data":{"text/plain":"fault\n0    1006\n1       8\nName: count, dtype: int64"},"metadata":{}}],"execution_count":19},{"cell_type":"code","source":"import matplotlib.pyplot as plt\n\nsender = 2  # faulty sensor\n\nplt.figure(figsize=(12, 4))\n\ndf_s = df_anomaly[df_anomaly.sender == sender]\n\nplt.plot(\n    df_s.time_index,\n    df_s.anomaly_score,\n    label=\"Anomaly score\",\n    linewidth=2\n)\n\nfor t in fault_times:\n    plt.axvline(t, color=\"red\", alpha=0.2)\n\nplt.xlabel(\"Time index\")\nplt.ylabel(\"Reconstruction error\")\nplt.title(\"Anomaly score over time (Sender 2)\")\nplt.legend()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:10:14.711627Z","iopub.execute_input":"2026-01-27T11:10:14.712017Z","iopub.status.idle":"2026-01-27T11:10:15.151160Z","shell.execute_reply.started":"2026-01-27T11:10:14.711987Z","shell.execute_reply":"2026-01-27T11:10:15.149740Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":20},{"cell_type":"code","source":"plt.figure(figsize=(6, 4))\n\ndf_anomaly[df_anomaly.fault == 0].anomaly_score.hist(\n    bins=40,\n    alpha=0.7,\n    label=\"Normal\",\n    density=True\n)\n\ndf_anomaly[df_anomaly.fault == 1].anomaly_score.hist(\n    bins=40,\n    alpha=0.7,\n    label=\"Fault\",\n    density=True\n)\n\nplt.xlabel(\"Anomaly score\")\nplt.ylabel(\"Density\")\nplt.title(\"Anomaly score distribution\")\nplt.legend()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:10:30.730126Z","iopub.execute_input":"2026-01-27T11:10:30.730512Z","iopub.status.idle":"2026-01-27T11:10:31.078696Z","shell.execute_reply.started":"2026-01-27T11:10:30.730480Z","shell.execute_reply":"2026-01-27T11:10:31.077844Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":21},{"cell_type":"code","source":"plt.figure(figsize=(5, 4))\n\ndf_anomaly.boxplot(\n    column=\"anomaly_score\",\n    by=\"fault\",\n    grid=False\n)\n\nplt.xticks([1, 2], [\"Normal\", \"Fault\"])\nplt.ylabel(\"Anomaly score\")\nplt.title(\"Fault vs Normal Anomaly Scores\")\nplt.suptitle(\"\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:10:47.084438Z","iopub.execute_input":"2026-01-27T11:10:47.084805Z","iopub.status.idle":"2026-01-27T11:10:47.232069Z","shell.execute_reply.started":"2026-01-27T11:10:47.084775Z","shell.execute_reply":"2026-01-27T11:10:47.231090Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 500x400 with 0 Axes>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":22},{"cell_type":"code","source":"from sklearn.metrics import roc_auc_score\n\nauc = roc_auc_score(\n    df_anomaly.fault,\n    df_anomaly.anomaly_score\n)\n\nprint(\"ROC-AUC:\", auc)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:10:58.508945Z","iopub.execute_input":"2026-01-27T11:10:58.509878Z","iopub.status.idle":"2026-01-27T11:10:59.297640Z","shell.execute_reply.started":"2026-01-27T11:10:58.509844Z","shell.execute_reply":"2026-01-27T11:10:59.296684Z"}},"outputs":[{"name":"stdout","text":"ROC-AUC: 0.5647365805168986\n","output_type":"stream"}],"execution_count":23},{"cell_type":"markdown","source":"Option A (Graph Autoencoder Anomaly Detection) — Frozen Results\n\nApproach:\nUnsupervised graph autoencoder trained to reconstruct normal sensor behavior.\nAnomaly scores defined as node-wise reconstruction error.\n\nFindings:\nFault and normal anomaly score distributions exhibit substantial overlap.\nTemporal anomaly spikes are not uniquely associated with fault windows.\nROC-AUC ≈ 0.56 indicates near-random discrimination.\n\nInterpretation:\nStructured sensor faults preserve marginal feature statistics while violating\nrelational consistency. Reconstruction-based anomaly detection is therefore\ninsufficient for reliable fault detection in this setting.\n\nConclusion:\nUnsupervised anomaly detection is ineffective for structured, adversarial faults.\nThis option is frozen and will not be further optimized.\n","metadata":{}},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}