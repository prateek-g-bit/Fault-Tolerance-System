{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":14637588,"sourceType":"datasetVersion","datasetId":9350581}],"dockerImageVersionId":31259,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:25.712371Z","iopub.execute_input":"2026-01-27T10:55:25.712702Z","iopub.status.idle":"2026-01-27T10:55:26.102392Z","shell.execute_reply.started":"2026-01-27T10:55:25.712670Z","shell.execute_reply":"2026-01-27T10:55:26.101304Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/dataset/fault_times.json\n/kaggle/input/dataset/calibration_only_params.json\n/kaggle/input/dataset/synthetic_ground_truth.csv\n/kaggle/input/dataset/adjacency.npy\n/kaggle/input/dataset/df_faulty_adv.csv\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import json\nimport pandas as pd\n\n# Load data\ndf_faulty = pd.read_csv(\"/kaggle/input/dataset/df_faulty_adv.csv\")\n\nwith open(\"/kaggle/input/dataset/fault_times.json\") as f:\n    fault_times = set(json.load(f))\n\nFAULTY_NODES = {2}   # start simple and controlled\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.103741Z","iopub.execute_input":"2026-01-27T10:55:26.104281Z","iopub.status.idle":"2026-01-27T10:55:26.123655Z","shell.execute_reply.started":"2026-01-27T10:55:26.104237Z","shell.execute_reply":"2026-01-27T10:55:26.122677Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"df_faulty[\"fault_label\"] = (\n    df_faulty[\"time_index\"].isin(fault_times) &\n    df_faulty[\"sender\"].isin(FAULTY_NODES)\n).astype(int)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.125676Z","iopub.execute_input":"2026-01-27T10:55:26.127526Z","iopub.status.idle":"2026-01-27T10:55:26.134794Z","shell.execute_reply.started":"2026-01-27T10:55:26.127460Z","shell.execute_reply":"2026-01-27T10:55:26.133623Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# How many fault vs clean samples?\nprint(df_faulty[\"fault_label\"].value_counts())\n\n# Inspect a few rows during fault times\ndf_faulty[\n    (df_faulty.sender == 2) &\n    (df_faulty.time_index.isin(list(fault_times)[:5]))\n].head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.136221Z","iopub.execute_input":"2026-01-27T10:55:26.136645Z","iopub.status.idle":"2026-01-27T10:55:26.172240Z","shell.execute_reply.started":"2026-01-27T10:55:26.136604Z","shell.execute_reply":"2026-01-27T10:55:26.171227Z"}},"outputs":[{"name":"stdout","text":"fault_label\n0    1233\n1      20\nName: count, dtype: int64\n","output_type":"stream"},{"execution_count":4,"output_type":"execute_result","data":{"text/plain":"     time_index  sender     modality probe    value  fault_label\n400          53       2     moisture    M1    70.23            1\n401          53       2     moisture    M2    39.67            1\n402          53       2         rain     R  3000.00            1\n403          53       2  temperature    T1    23.33            1\n404          53       2  temperature    T2    26.29            1","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>time_index</th>\n      <th>sender</th>\n      <th>modality</th>\n      <th>probe</th>\n      <th>value</th>\n      <th>fault_label</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>400</th>\n      <td>53</td>\n      <td>2</td>\n      <td>moisture</td>\n      <td>M1</td>\n      <td>70.23</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>401</th>\n      <td>53</td>\n      <td>2</td>\n      <td>moisture</td>\n      <td>M2</td>\n      <td>39.67</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>402</th>\n      <td>53</td>\n      <td>2</td>\n      <td>rain</td>\n      <td>R</td>\n      <td>3000.00</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>403</th>\n      <td>53</td>\n      <td>2</td>\n      <td>temperature</td>\n      <td>T1</td>\n      <td>23.33</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>404</th>\n      <td>53</td>\n      <td>2</td>\n      <td>temperature</td>\n      <td>T2</td>\n      <td>26.29</td>\n      <td>1</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":4},{"cell_type":"code","source":"import pandas as pd\n\ndf = pd.read_csv(\"/kaggle/input/dataset/df_faulty_adv.csv\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.173602Z","iopub.execute_input":"2026-01-27T10:55:26.173956Z","iopub.status.idle":"2026-01-27T10:55:26.187225Z","shell.execute_reply.started":"2026-01-27T10:55:26.173913Z","shell.execute_reply":"2026-01-27T10:55:26.185608Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"# Create fault label\ndf[\"fault_label\"] = (\n    df[\"time_index\"].isin(fault_times) &\n    df[\"sender\"].isin(FAULTY_NODES)\n).astype(int)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.190588Z","iopub.execute_input":"2026-01-27T10:55:26.191270Z","iopub.status.idle":"2026-01-27T10:55:26.201596Z","shell.execute_reply.started":"2026-01-27T10:55:26.191224Z","shell.execute_reply":"2026-01-27T10:55:26.200425Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"df[\"theta_calib\"] = df[\"value\"]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.203220Z","iopub.execute_input":"2026-01-27T10:55:26.203646Z","iopub.status.idle":"2026-01-27T10:55:26.218907Z","shell.execute_reply.started":"2026-01-27T10:55:26.203605Z","shell.execute_reply":"2026-01-27T10:55:26.217584Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"probe_diff = (\n    df\n    .pivot_table(\n        index=[\"time_index\", \"sender\"],\n        columns=\"probe\",\n        values=\"value\"\n    )\n    .dropna()\n)\n\nprobe_diff[\"probe_disagreement\"] = (\n    probe_diff.iloc[:, 0] - probe_diff.iloc[:, 1]\n).abs()\n\nprobe_diff = probe_diff.reset_index()[[\n    \"time_index\", \"sender\", \"probe_disagreement\"\n]]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.220863Z","iopub.execute_input":"2026-01-27T10:55:26.221233Z","iopub.status.idle":"2026-01-27T10:55:26.249601Z","shell.execute_reply.started":"2026-01-27T10:55:26.221179Z","shell.execute_reply":"2026-01-27T10:55:26.248525Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"df = df.merge(\n    probe_diff,\n    on=[\"time_index\", \"sender\"],\n    how=\"left\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.251405Z","iopub.execute_input":"2026-01-27T10:55:26.251798Z","iopub.status.idle":"2026-01-27T10:55:26.260762Z","shell.execute_reply.started":"2026-01-27T10:55:26.251761Z","shell.execute_reply":"2026-01-27T10:55:26.259624Z"}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"df = df.sort_values([\"sender\", \"time_index\"])\n\ndf[\"delta_theta\"] = (\n    df\n    .groupby(\"sender\")[\"theta_calib\"]\n    .diff()\n    .abs()\n    .fillna(0.0)\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.263150Z","iopub.execute_input":"2026-01-27T10:55:26.263692Z","iopub.status.idle":"2026-01-27T10:55:26.280874Z","shell.execute_reply.started":"2026-01-27T10:55:26.263554Z","shell.execute_reply":"2026-01-27T10:55:26.279825Z"}},"outputs":[],"execution_count":10},{"cell_type":"code","source":"FEATURE_COLUMNS = [\n    \"theta_calib\",\n    \"probe_disagreement\",\n    \"delta_theta\"\n]\n\nfor col in FEATURE_COLUMNS:\n    df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n\ndf[FEATURE_COLUMNS] = df[FEATURE_COLUMNS].fillna(0.0)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.282165Z","iopub.execute_input":"2026-01-27T10:55:26.282592Z","iopub.status.idle":"2026-01-27T10:55:26.292980Z","shell.execute_reply.started":"2026-01-27T10:55:26.282552Z","shell.execute_reply":"2026-01-27T10:55:26.291749Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"print(df[FEATURE_COLUMNS].dtypes)\nprint(df[FEATURE_COLUMNS].isna().sum())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.294098Z","iopub.execute_input":"2026-01-27T10:55:26.294592Z","iopub.status.idle":"2026-01-27T10:55:26.318650Z","shell.execute_reply.started":"2026-01-27T10:55:26.294549Z","shell.execute_reply":"2026-01-27T10:55:26.317616Z"}},"outputs":[{"name":"stdout","text":"theta_calib           float64\nprobe_disagreement    float64\ndelta_theta           float64\ndtype: object\ntheta_calib           0\nprobe_disagreement    0\ndelta_theta           0\ndtype: int64\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"NODE_IDS = [0, 1, 2, 3, 4, 101]\nNODE_TO_IDX = {n: i for i, n in enumerate(NODE_IDS)}\nNUM_NODES = len(NODE_IDS)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.319995Z","iopub.execute_input":"2026-01-27T10:55:26.320732Z","iopub.status.idle":"2026-01-27T10:55:26.331770Z","shell.execute_reply.started":"2026-01-27T10:55:26.320694Z","shell.execute_reply":"2026-01-27T10:55:26.330577Z"}},"outputs":[],"execution_count":13},{"cell_type":"code","source":"import torch\nimport numpy as np\n\ndef build_fault_classification_snapshots(\n    df,\n    feature_cols,\n    label_col\n):\n    snapshots = []\n\n    for t in sorted(df.time_index.unique()):\n        df_t = df[df.time_index == t]\n\n        # Initialize\n        x = torch.zeros((NUM_NODES, len(feature_cols)), dtype=torch.float32)\n        y = torch.zeros(NUM_NODES, dtype=torch.float32)\n\n        for _, row in df_t.iterrows():\n            idx = NODE_TO_IDX[row.sender]\n\n            x[idx] = torch.tensor(\n                row[feature_cols].to_numpy(dtype=np.float32),\n                dtype=torch.float32\n            )\n\n            y[idx] = float(row[label_col])\n\n        snapshots.append({\n            \"x\": x,\n            \"y\": y\n        })\n\n    return snapshots\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:26.333167Z","iopub.execute_input":"2026-01-27T10:55:26.333920Z","iopub.status.idle":"2026-01-27T10:55:28.464284Z","shell.execute_reply.started":"2026-01-27T10:55:26.333882Z","shell.execute_reply":"2026-01-27T10:55:28.463146Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"FEATURE_COLUMNS = [\n    \"theta_calib\",\n    \"probe_disagreement\",\n    \"delta_theta\"\n]\n\nsnapshots = build_fault_classification_snapshots(\n    df,\n    FEATURE_COLUMNS,\n    \"fault_label\"\n)\n\nprint(f\"Built {len(snapshots)} graph snapshots\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:28.465752Z","iopub.execute_input":"2026-01-27T10:55:28.466297Z","iopub.status.idle":"2026-01-27T10:55:29.188097Z","shell.execute_reply.started":"2026-01-27T10:55:28.466259Z","shell.execute_reply":"2026-01-27T10:55:29.187136Z"}},"outputs":[{"name":"stdout","text":"Built 169 graph snapshots\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"# Check shapes\nsnap = snapshots[0]\nprint(\"x shape:\", snap[\"x\"].shape)  # (6, 3)\nprint(\"y shape:\", snap[\"y\"].shape)  # (6,)\n\n# Check label sparsity\nall_labels = torch.cat([s[\"y\"] for s in snapshots])\nprint(\"Fault labels:\", torch.unique(all_labels, return_counts=True))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.189551Z","iopub.execute_input":"2026-01-27T10:55:29.189896Z","iopub.status.idle":"2026-01-27T10:55:29.201103Z","shell.execute_reply.started":"2026-01-27T10:55:29.189858Z","shell.execute_reply":"2026-01-27T10:55:29.200001Z"}},"outputs":[{"name":"stdout","text":"x shape: torch.Size([6, 3])\ny shape: torch.Size([6])\nFault labels: (tensor([0., 1.]), tensor([1010,    4]))\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.202105Z","iopub.execute_input":"2026-01-27T10:55:29.202442Z","iopub.status.idle":"2026-01-27T10:55:29.219101Z","shell.execute_reply.started":"2026-01-27T10:55:29.202406Z","shell.execute_reply":"2026-01-27T10:55:29.218041Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"class FaultDetectionGNN(nn.Module):\n    def __init__(self, in_dim, hidden_dim=16):\n        super().__init__()\n        self.fc1 = nn.Linear(in_dim, hidden_dim)\n        self.fc2 = nn.Linear(hidden_dim, 1)\n\n    def forward(self, x, A):\n        \"\"\"\n        x: (N, F)\n        A: (N, N) normalized adjacency\n        \"\"\"\n        h = torch.matmul(A, x)          # graph aggregation\n        h = F.relu(self.fc1(h))         # nonlinearity\n        logits = self.fc2(h).squeeze()  # (N,)\n        return logits\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.220548Z","iopub.execute_input":"2026-01-27T10:55:29.220930Z","iopub.status.idle":"2026-01-27T10:55:29.242097Z","shell.execute_reply.started":"2026-01-27T10:55:29.220902Z","shell.execute_reply":"2026-01-27T10:55:29.240941Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"import numpy as np\nimport torch\n\nA_norm = np.load(\"/kaggle/input/dataset/adjacency.npy\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.243429Z","iopub.execute_input":"2026-01-27T10:55:29.243797Z","iopub.status.idle":"2026-01-27T10:55:29.262843Z","shell.execute_reply.started":"2026-01-27T10:55:29.243768Z","shell.execute_reply":"2026-01-27T10:55:29.261613Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"A = torch.tensor(A_norm, dtype=torch.float32)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.264350Z","iopub.execute_input":"2026-01-27T10:55:29.265086Z","iopub.status.idle":"2026-01-27T10:55:29.280813Z","shell.execute_reply.started":"2026-01-27T10:55:29.265052Z","shell.execute_reply":"2026-01-27T10:55:29.279429Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"model = FaultDetectionGNN(in_dim=len(FEATURE_COLUMNS))\nsnap = snapshots[0]\n\nlogits = model(snap[\"x\"], A)\nprint(logits.shape)   # should be (6,)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.284790Z","iopub.execute_input":"2026-01-27T10:55:29.285161Z","iopub.status.idle":"2026-01-27T10:55:29.302227Z","shell.execute_reply.started":"2026-01-27T10:55:29.285132Z","shell.execute_reply":"2026-01-27T10:55:29.300924Z"}},"outputs":[{"name":"stdout","text":"torch.Size([6])\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"snap[\"x\"].shape == (6, len(FEATURE_COLUMNS))\nA.shape == (6, 6)\nsnap[\"y\"].shape == (6,)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.303728Z","iopub.execute_input":"2026-01-27T10:55:29.304101Z","iopub.status.idle":"2026-01-27T10:55:29.321324Z","shell.execute_reply.started":"2026-01-27T10:55:29.304065Z","shell.execute_reply":"2026-01-27T10:55:29.320418Z"}},"outputs":[{"execution_count":22,"output_type":"execute_result","data":{"text/plain":"True"},"metadata":{}}],"execution_count":22},{"cell_type":"code","source":"def get_fault_loss(pos_weight):\n    \"\"\"\n    pos_weight > 1 penalizes missed faults more\n    \"\"\"\n    return nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor(pos_weight)\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.322786Z","iopub.execute_input":"2026-01-27T10:55:29.323941Z","iopub.status.idle":"2026-01-27T10:55:29.342700Z","shell.execute_reply.started":"2026-01-27T10:55:29.323908Z","shell.execute_reply":"2026-01-27T10:55:29.341574Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"def train_fault_detector(\n    model,\n    snapshots,\n    A,\n    epochs=50,\n    lr=1e-3,\n    pos_weight=5.0\n):\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n    loss_fn = get_fault_loss(pos_weight)\n\n    model.train()\n\n    for epoch in range(epochs):\n        losses = []\n\n        for snap in snapshots:\n            optimizer.zero_grad()\n\n            logits = model(snap[\"x\"], A)\n            loss = loss_fn(logits, snap[\"y\"])\n\n            loss.backward()\n            optimizer.step()\n\n            losses.append(loss.item())\n\n        if epoch % 10 == 0:\n            print(f\"Epoch {epoch:03d} | Loss: {np.mean(losses):.4f}\")\n\n    return model\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.343977Z","iopub.execute_input":"2026-01-27T10:55:29.344889Z","iopub.status.idle":"2026-01-27T10:55:29.364652Z","shell.execute_reply.started":"2026-01-27T10:55:29.344859Z","shell.execute_reply":"2026-01-27T10:55:29.363414Z"}},"outputs":[],"execution_count":24},{"cell_type":"code","source":"def predict_faults(model, snapshots, A, threshold=0.5):\n    model.eval()\n    records = []\n\n    with torch.no_grad():\n        for t, snap in enumerate(snapshots):\n            logits = model(snap[\"x\"], A)\n            probs = torch.sigmoid(logits)\n\n            for i, node in enumerate(NODE_IDS):\n                records.append([\n                    t,\n                    node,\n                    float(probs[i]),\n                    int(probs[i] > threshold)\n                ])\n\n    return pd.DataFrame(\n        records,\n        columns=[\"time_index\", \"sender\", \"prob_fault\", \"pred_fault\"]\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.366400Z","iopub.execute_input":"2026-01-27T10:55:29.366791Z","iopub.status.idle":"2026-01-27T10:55:29.392669Z","shell.execute_reply.started":"2026-01-27T10:55:29.366754Z","shell.execute_reply":"2026-01-27T10:55:29.391219Z"}},"outputs":[],"execution_count":25},{"cell_type":"code","source":"from sklearn.metrics import precision_score, recall_score, f1_score\n\ndef evaluate_fault_detection(df_pred, df_true):\n    merged = df_pred.merge(\n        df_true,\n        on=[\"time_index\", \"sender\"],\n        suffixes=(\"_pred\", \"_true\")\n    )\n\n    y_true = merged[\"fault_label\"].values\n    y_pred = merged[\"pred_fault\"].values\n\n    return {\n        \"precision\": precision_score(y_true, y_pred, zero_division=0),\n        \"recall\": recall_score(y_true, y_pred, zero_division=0),\n        \"f1\": f1_score(y_true, y_pred, zero_division=0)\n    }\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:29.394366Z","iopub.execute_input":"2026-01-27T10:55:29.394860Z","iopub.status.idle":"2026-01-27T10:55:30.216679Z","shell.execute_reply.started":"2026-01-27T10:55:29.394814Z","shell.execute_reply":"2026-01-27T10:55:30.215587Z"}},"outputs":[],"execution_count":26},{"cell_type":"code","source":"def build_fault_labels(df, fault_times, faulty_sender=2):\n    labels = []\n\n    for t in df.time_index.unique():\n        for sender in df.sender.unique():\n            fault = int((t in fault_times) and (sender == faulty_sender))\n            labels.append([t, sender, fault])\n\n    return pd.DataFrame(\n        labels,\n        columns=[\"time_index\", \"sender\", \"fault_label\"]\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:30.217958Z","iopub.execute_input":"2026-01-27T10:55:30.218984Z","iopub.status.idle":"2026-01-27T10:55:30.225861Z","shell.execute_reply.started":"2026-01-27T10:55:30.218949Z","shell.execute_reply":"2026-01-27T10:55:30.224582Z"}},"outputs":[],"execution_count":27},{"cell_type":"code","source":"df_fault_labels = build_fault_labels(\n    df=df_faulty,\n    fault_times=fault_times,\n    faulty_sender=2\n)\n\n\ndf_fault_labels.head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:55:30.227195Z","iopub.execute_input":"2026-01-27T10:55:30.227721Z","iopub.status.idle":"2026-01-27T10:55:30.270953Z","shell.execute_reply.started":"2026-01-27T10:55:30.227681Z","shell.execute_reply":"2026-01-27T10:55:30.269844Z"}},"outputs":[{"execution_count":28,"output_type":"execute_result","data":{"text/plain":"   time_index  sender  fault_label\n0           0 