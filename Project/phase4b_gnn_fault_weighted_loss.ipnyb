{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":14629066,"sourceType":"datasetVersion","datasetId":9344800},{"sourceId":14629128,"sourceType":"datasetVersion","datasetId":9344844}],"dockerImageVersionId":31259,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:23.070334Z","iopub.execute_input":"2026-01-27T10:24:23.070598Z","iopub.status.idle":"2026-01-27T10:24:23.436211Z","shell.execute_reply.started":"2026-01-27T10:24:23.070571Z","shell.execute_reply":"2026-01-27T10:24:23.435132Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/faulty/fault_times.json\n/kaggle/input/faulty/adjacency.npy\n/kaggle/input/faulty/synthetic_ground_truth_eval.csv\n/kaggle/input/faulty/df_faulty_adv.csv\n/kaggle/input/frozen-option-2/fig_fault_penalty_option2.png\n/kaggle/input/frozen-option-2/gnn_option2_full_model.pt\n/kaggle/input/frozen-option-2/fig_rmse_comparison_option2.png\n/kaggle/input/frozen-option-2/gnn_option2_no_probe_model.pt\n/kaggle/input/frozen-option-2/frozen_gnn_option2_metrics.json\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"summary_text = \"\"\"\nOption 2 (Naive GNN) — Frozen Results\n\nExperiment:\nNaive Graph Neural Network trained to predict residual corrections\nusing mean squared error loss.\n\nKey Finding:\nThe GNN fails to meaningfully exploit probe disagreement, graph structure,\nor temporal features. Ablation studies show negligible performance differences\nacross all variants.\n\nInterpretation:\nThe learning objective collapses to a near-constant estimator that smooths\nsignals without fault awareness. This indicates that naive residual regression\nis insufficient for fault-tolerant estimation.\n\nConclusion:\nExplicit fault-aware objectives are required for GNN-based robustness.\nThis experiment is frozen and will not be further tuned.\n\nStatus:\nFrozen — serves as baseline for fault-aware GNN extensions.\n\"\"\"\n\nwith open(\"/kaggle/working/OPTION2_FREEZE_SUMMARY.txt\", \"w\") as f:\n    f.write(summary_text)\n\nprint(\"OPTION2_FREEZE_SUMMARY.txt created successfully\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:23.437301Z","iopub.execute_input":"2026-01-27T10:24:23.437668Z","iopub.status.idle":"2026-01-27T10:24:23.445422Z","shell.execute_reply.started":"2026-01-27T10:24:23.437643Z","shell.execute_reply":"2026-01-27T10:24:23.444360Z"}},"outputs":[{"name":"stdout","text":"OPTION2_FREEZE_SUMMARY.txt created successfully\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nfrom sklearn.metrics import mean_squared_error\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:23.446438Z","iopub.execute_input":"2026-01-27T10:24:23.446739Z","iopub.status.idle":"2026-01-27T10:24:29.292553Z","shell.execute_reply.started":"2026-01-27T10:24:23.446711Z","shell.execute_reply":"2026-01-27T10:24:29.291424Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"DEVICE = \"cpu\"\nLAMBDA_FAULT = 8.0   # start with 5–10\nEPOCHS = 50\nLR = 1e-3\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.293996Z","iopub.execute_input":"2026-01-27T10:24:29.294994Z","iopub.status.idle":"2026-01-27T10:24:29.299411Z","shell.execute_reply.started":"2026-01-27T10:24:29.294961Z","shell.execute_reply":"2026-01-27T10:24:29.298529Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"# Faulty calibrated dataframe\ndf_faulty = pd.read_csv(\"/kaggle/input/faulty/df_faulty_adv.csv\")\n\n# Ground truth\ndf_true = pd.read_csv(\n    \"/kaggle/input/faulty/synthetic_ground_truth_eval.csv\"\n)\n\n# Fault times\nimport json\nwith open(\"/kaggle/input/faulty/fault_times.json\") as f:\n    fault_times = set(json.load(f))\n\n# Adjacency\nA_norm = np.load(\"/kaggle/input/faulty/adjacency.npy\")\nA = torch.tensor(A_norm, dtype=torch.float32)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.300661Z","iopub.execute_input":"2026-01-27T10:24:29.301038Z","iopub.status.idle":"2026-01-27T10:24:29.394799Z","shell.execute_reply.started":"2026-01-27T10:24:29.301010Z","shell.execute_reply":"2026-01-27T10:24:29.393847Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"df_true_m = df_true[df_true.modality == \"moisture\"]\n\nsupervised = df_faulty.merge(\n    df_true_m[[\"time_index\", \"sender\", \"value\"]],\n    on=[\"time_index\", \"sender\"],\n    suffixes=(\"_calib\", \"_true\")\n)\n\nsupervised[\"residual_target\"] = (\n    supervised[\"value_true\"] - supervised[\"value_calib\"]\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.396032Z","iopub.execute_input":"2026-01-27T10:24:29.396323Z","iopub.status.idle":"2026-01-27T10:24:29.424388Z","shell.execute_reply.started":"2026-01-27T10:24:29.396296Z","shell.execute_reply":"2026-01-27T10:24:29.423403Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"supervised = supervised[supervised[\"modality\"] == \"moisture\"].copy()\nsupervised = supervised.drop(columns=[\"probe\"])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.425655Z","iopub.execute_input":"2026-01-27T10:24:29.426046Z","iopub.status.idle":"2026-01-27T10:24:29.445419Z","shell.execute_reply.started":"2026-01-27T10:24:29.426009Z","shell.execute_reply":"2026-01-27T10:24:29.444357Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"supervised[\"theta_calib\"] = supervised[\"value_calib\"]\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.446652Z","iopub.execute_input":"2026-01-27T10:24:29.447045Z","iopub.status.idle":"2026-01-27T10:24:29.452261Z","shell.execute_reply.started":"2026-01-27T10:24:29.447008Z","shell.execute_reply":"2026-01-27T10:24:29.451388Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"probe_diff = (\n    df_faulty\n    .pivot_table(\n        index=[\"time_index\", \"sender\"],\n        columns=\"probe\",\n        values=\"value\"\n    )\n    .dropna()\n)\n\nprobe_diff[\"probe_disagreement\"] = (\n    probe_diff.iloc[:, 0] - probe_diff.iloc[:, 1]\n).abs()\n\nprobe_diff = probe_diff.reset_index()[[\n    \"time_index\", \"sender\", \"probe_disagreement\"\n]]\n\nsupervised = supervised.merge(\n    probe_diff,\n    on=[\"time_index\", \"sender\"],\n    how=\"left\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.454973Z","iopub.execute_input":"2026-01-27T10:24:29.455324Z","iopub.status.idle":"2026-01-27T10:24:29.501814Z","shell.execute_reply.started":"2026-01-27T10:24:29.455298Z","shell.execute_reply":"2026-01-27T10:24:29.500975Z"}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"supervised = supervised.sort_values([\"sender\", \"time_index\"])\n\nsupervised[\"delta_theta\"] = (\n    supervised\n    .groupby(\"sender\")[\"theta_calib\"]\n    .diff()\n    .fillna(0.0)\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.502825Z","iopub.execute_input":"2026-01-27T10:24:29.503111Z","iopub.status.idle":"2026-01-27T10:24:29.514612Z","shell.execute_reply.started":"2026-01-27T10:24:29.503086Z","shell.execute_reply":"2026-01-27T10:24:29.513721Z"}},"outputs":[],"execution_count":10},{"cell_type":"code","source":"supervised = (\n    supervised\n    .groupby([\"time_index\", \"sender\"], as_index=False)\n    .agg({\n        \"value_calib\": \"mean\",\n        \"value_true\": \"mean\",\n        \"residual_target\": \"mean\",\n        \"theta_calib\": \"mean\",\n        \"probe_disagreement\": \"mean\",\n        \"delta_theta\": \"mean\"\n    })\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.515801Z","iopub.execute_input":"2026-01-27T10:24:29.516512Z","iopub.status.idle":"2026-01-27T10:24:29.529848Z","shell.execute_reply.started":"2026-01-27T10:24:29.516480Z","shell.execute_reply":"2026-01-27T10:24:29.528995Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"FEATURE_COLUMNS = [\n    \"theta_calib\",\n    \"probe_disagreement\",\n    \"delta_theta\"\n]\n\nsupervised[FEATURE_COLUMNS] = (\n    supervised[FEATURE_COLUMNS]\n    .apply(pd.to_numeric, errors=\"coerce\")\n    .fillna(0.0)\n)\n\nprint(supervised[FEATURE_COLUMNS].dtypes)\nprint(supervised[FEATURE_COLUMNS].isna().sum())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.531029Z","iopub.execute_input":"2026-01-27T10:24:29.531315Z","iopub.status.idle":"2026-01-27T10:24:29.553832Z","shell.execute_reply.started":"2026-01-27T10:24:29.531280Z","shell.execute_reply":"2026-01-27T10:24:29.552957Z"}},"outputs":[{"name":"stdout","text":"theta_calib           float64\nprobe_disagreement    float64\ndelta_theta           float64\ndtype: object\ntheta_calib           0\nprobe_disagreement    0\ndelta_theta           0\ndtype: int64\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"NODE_IDS = [0, 1, 2, 3, 4, 101]\nNODE_TO_IDX = {n: i for i, n in enumerate(NODE_IDS)}\n\ndef build_graph_snapshots(df, feature_cols, target_col):\n    snapshots = []\n\n    for t in sorted(df.time_index.unique()):\n        df_t = df[df.time_index == t]\n\n        x = torch.zeros((len(NODE_IDS), len(feature_cols)), dtype=torch.float32)\n        y = torch.zeros(len(NODE_IDS), dtype=torch.float32)\n        fault_mask = torch.zeros(len(NODE_IDS), dtype=torch.float32)\n\n        for _, row in df_t.iterrows():\n            idx = NODE_TO_IDX[row.sender]\n            x[idx] = torch.tensor(\n                row[feature_cols].to_numpy(dtype=np.float32)\n            )\n            y[idx] = float(row[target_col])\n\n            if t in fault_times:\n                fault_mask[idx] = 1.0\n\n        snapshots.append({\n            \"x\": x,\n            \"y\": y,\n            \"fault_mask\": fault_mask\n        })\n\n    return snapshots\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.555020Z","iopub.execute_input":"2026-01-27T10:24:29.555282Z","iopub.status.idle":"2026-01-27T10:24:29.571624Z","shell.execute_reply.started":"2026-01-27T10:24:29.555256Z","shell.execute_reply":"2026-01-27T10:24:29.570744Z"}},"outputs":[],"execution_count":13},{"cell_type":"code","source":"snapshots = build_graph_snapshots(\n    supervised,\n    FEATURE_COLUMNS,\n    \"residual_target\"\n)\n\nprint(len(snapshots), snapshots[0][\"x\"].shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.572636Z","iopub.execute_input":"2026-01-27T10:24:29.572930Z","iopub.status.idle":"2026-01-27T10:24:29.800362Z","shell.execute_reply.started":"2026-01-27T10:24:29.572876Z","shell.execute_reply":"2026-01-27T10:24:29.799553Z"}},"outputs":[{"name":"stdout","text":"163 torch.Size([6, 3])\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"class SimpleGNN(nn.Module):\n    def __init__(self, in_dim, hidden_dim=16):\n        super().__init__()\n        self.fc1 = nn.Linear(in_dim, hidden_dim)\n        self.fc2 = nn.Linear(hidden_dim, 1)\n\n    def forward(self, x, A):\n        h = torch.matmul(A, x)\n        h = F.relu(self.fc1(h))\n        return self.fc2(h).squeeze()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.801304Z","iopub.execute_input":"2026-01-27T10:24:29.801570Z","iopub.status.idle":"2026-01-27T10:24:29.807248Z","shell.execute_reply.started":"2026-01-27T10:24:29.801544Z","shell.execute_reply":"2026-01-27T10:24:29.806365Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"def fault_weighted_mse(pred, target, fault_mask, lambda_fault):\n    clean_loss = ((pred - target)**2 * (1 - fault_mask)).mean()\n    fault_loss = ((pred - target)**2 * fault_mask).mean()\n    return clean_loss + lambda_fault * fault_loss\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.808249Z","iopub.execute_input":"2026-01-27T10:24:29.808473Z","iopub.status.idle":"2026-01-27T10:24:29.825251Z","shell.execute_reply.started":"2026-01-27T10:24:29.808451Z","shell.execute_reply":"2026-01-27T10:24:29.824332Z"}},"outputs":[],"execution_count":16},{"cell_type":"code","source":"def train_fault_weighted_gnn(snapshots, A, in_dim):\n    model = SimpleGNN(in_dim).to(DEVICE)\n    optimizer = torch.optim.Adam(model.parameters(), lr=LR)\n\n    for epoch in range(EPOCHS):\n        losses = []\n\n        for snap in snapshots:\n            optimizer.zero_grad()\n\n            pred = model(snap[\"x\"], A)\n            loss = fault_weighted_mse(\n                pred,\n                snap[\"y\"],\n                snap[\"fault_mask\"],\n                LAMBDA_FAULT\n            )\n\n            loss.backward()\n            optimizer.step()\n            losses.append(loss.item())\n\n        if epoch % 10 == 0:\n            print(f\"Epoch {epoch:03d} | Loss: {np.mean(losses):.4f}\")\n\n    return model\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.826334Z","iopub.execute_input":"2026-01-27T10:24:29.826597Z","iopub.status.idle":"2026-01-27T10:24:29.847060Z","shell.execute_reply.started":"2026-01-27T10:24:29.826570Z","shell.execute_reply":"2026-01-27T10:24:29.846112Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"model_fw = train_fault_weighted_gnn(\n    snapshots,\n    A,\n    in_dim=len(FEATURE_COLUMNS)\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:29.848119Z","iopub.execute_input":"2026-01-27T10:24:29.848412Z","iopub.status.idle":"2026-01-27T10:24:43.903099Z","shell.execute_reply.started":"2026-01-27T10:24:29.848374Z","shell.execute_reply":"2026-01-27T10:24:43.902174Z"}},"outputs":[{"name":"stdout","text":"Epoch 000 | Loss: 0.9982\nEpoch 010 | Loss: 0.8053\nEpoch 020 | Loss: 0.7942\nEpoch 030 | Loss: 0.7898\nEpoch 040 | Loss: 0.7881\n","output_type":"stream"}],"execution_count":18},{"cell_type":"code","source":"def run_model(model, snapshots, A):\n    preds = []\n    for t, snap in enumerate(snapshots):\n        with torch.no_grad():\n            p = model(snap[\"x\"], A).numpy()\n        for i, node in enumerate(NODE_IDS):\n            preds.append([t, node, p[i]])\n    return pd.DataFrame(preds, columns=[\"time_index\", \"sender\", \"value\"])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:43.904403Z","iopub.execute_input":"2026-01-27T10:24:43.904975Z","iopub.status.idle":"2026-01-27T10:24:43.910504Z","shell.execute_reply.started":"2026-01-27T10:24:43.904938Z","shell.execute_reply":"2026-01-27T10:24:43.909654Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"def compute_rmse(df_pred, df_true):\n    merged = df_pred.merge(\n        df_true, on=[\"time_index\", \"sender\"],\n        suffixes=(\"_pred\", \"_true\")\n    )\n    return np.sqrt(mean_squared_error(\n        merged.value_true, merged.value_pred\n    ))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:43.911513Z","iopub.execute_input":"2026-01-27T10:24:43.911827Z","iopub.status.idle":"2026-01-27T10:24:43.930560Z","shell.execute_reply.started":"2026-01-27T10:24:43.911798Z","shell.execute_reply":"2026-01-27T10:24:43.929645Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"def compute_fault_penalty(df_pred, df_true, fault_times):\n    clean = df_true[~df_true.time_index.isin(fault_times)]\n    fault = df_true[df_true.time_index.isin(fault_times)]\n\n    return compute_rmse(df_pred, fault) - compute_rmse(df_pred, clean)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:43.931758Z","iopub.execute_input":"2026-01-27T10:24:43.932098Z","iopub.status.idle":"2026-01-27T10:24:43.950105Z","shell.execute_reply.started":"2026-01-27T10:24:43.932068Z","shell.execute_reply":"2026-01-27T10:24:43.949090Z"}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"df_pred_fw = run_model(model_fw, snapshots, A)\n\nrmse_fw = compute_rmse(df_pred_fw, df_true_m)\npenalty_fw = compute_fault_penalty(df_pred_fw, df_true_m, fault_times)\n\nprint(\"Fault-weighted GNN RMSE:\", rmse_fw)\nprint(\"Fault-weighted GNN fault penalty:\", penalty_fw)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:24:43.951295Z","iopub.execute_input":"2026-01-27T10:24:43.951579Z","iopub.status.idle":"2026-01-27T10:24:43.998551Z","shell.execute_reply.started":"2026-01-27T10:24:43.951552Z","shell.execute_reply":"2026-01-27T10:24:43.997790Z"}},"outputs":[{"name":"stdout","text":"Fault-weighted GNN RMSE: 66.4229037642841\nFault-weighted GNN fault penalty: -4.439026306057812\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"summary_text = \"\"\"\nOption 2B (Fault-weighted GNN) — Frozen Results\n\nExperiment:\nGNN trained with fault-weighted MSE loss to emphasize fault windows.\n\nResult:\nFault penalty remains strongly negative, indicating degraded fault handling.\nGlobal RMSE increases without improving fault localization.\n\nInterpretation:\nWeighting residual errors is insufficient for learning fault-aware behavior.\nThe GNN lacks an explicit mechanism to detect fault onset or isolate faulty nodes.\n\nConclusion:\nFault tolerance cannot be achieved via regression weighting alone.\nExplicit fault detection or structured objectives are required.\n\nStatus:\nFrozen — negative result informs next design stage.\n\"\"\"\n\nwith open(\"/kaggle/working/OPTION2B_FREEZE_SUMMARY.txt\", \"w\") as f:\n    f.write(summary_text)\n\nprint(\"OPTION2B_FREEZE_SUMMARY.txt created\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:26:26.523238Z","iopub.execute_input":"2026-01-27T10:26:26.523628Z","iopub.status.idle":"2026-01-27T10:26:26.530216Z","shell.execute_reply.started":"2026-01-27T10:26:26.523597Z","shell.execute_reply":"2026-01-27T10:26:26.529258Z"}},"outputs":[{"name":"stdout","text":"OPTION2B_FREEZE_SUMMARY.txt created\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"torch.save(\n    model_fw.state_dict(),\n    \"/kaggle/working/gnn_option2b_fault_weighted_model.pt\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:28:27.052392Z","iopub.execute_input":"2026-01-27T10:28:27.052789Z","iopub.status.idle":"2026-01-27T10:28:27.064950Z","shell.execute_reply.started":"2026-01-27T10:28:27.052758Z","shell.execute_reply":"2026-01-27T10:28:27.064018Z"}},"outputs":[],"execution_count":24},{"cell_type":"code","source":"frozen_metrics = {\n    \"model\": \"Fault-weighted GNN (Option 2B)\",\n    \"rmse\": float(compute_rmse(df_pred_fw, df_true_m)),\n    \"fault_penalty\": float(\n        compute_fault_penalty(df_pred_fw, df_true_m, fault_times)\n    ),\n    \"lambda_fault\": LAMBDA_FAULT,\n    \"epochs\": EPOCHS,\n    \"learning_rate\": LR\n}\n\nimport json\nwith open(\"/kaggle/working/frozen_option2b_metrics.json\", \"w\") as f:\n    json.dump(frozen_metrics, f, indent=2)\n\nprint(\"frozen_option2b_metrics.json saved\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:28:33.293419Z","iopub.execute_input":"2026-01-27T10:28:33.293757Z","iopub.status.idle":"2026-01-27T10:28:33.313180Z","shell.execute_reply.started":"2026-01-27T10:28:33.293729Z","shell.execute_reply":"2026-01-27T10:28:33.312277Z"}},"outputs":[{"name":"stdout","text":"frozen_option2b_metrics.json saved\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nplt.savefig(\n    \"/kaggle/working/fig_fault_penalty_option2b.png\",\n    bbox_inches=\"tight\",\n    dpi=300\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T10:29:02.438027Z","iopub.execute_input":"2026-01-27T10:29:02.438370Z","iopub.status.idle":"2026-01-27T10:29:02.633510Z","shell.execute_reply.started":"2026-01-27T10:29:02.438340Z","shell.execute_reply":"2026-01-27T10:29:02.632692Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 0 Axes>"},"metadata":{}}],"execution_count":27},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}