{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":14637839,"sourceType":"datasetVersion","datasetId":9350761}],"dockerImageVersionId":31259,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:18:49.329380Z","iopub.execute_input":"2026-01-27T11:18:49.329880Z","iopub.status.idle":"2026-01-27T11:18:50.656342Z","shell.execute_reply.started":"2026-01-27T11:18:49.329838Z","shell.execute_reply":"2026-01-27T11:18:50.655261Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/faulty-5a/fault_times.json\n/kaggle/input/faulty-5a/adjacency.npy\n/kaggle/input/faulty-5a/synthetic_ground_truth_eval.csv\n/kaggle/input/faulty-5a/df_faulty_adv.csv\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom sklearn.metrics import precision_recall_fscore_support, roc_auc_score\nimport json\n\n# Load datasets\ndf_faulty = pd.read_csv(\"/kaggle/input/faulty-5a/df_faulty_adv.csv\")\ndf_true = pd.read_csv(\"/kaggle/input/faulty-5a/synthetic_ground_truth_eval.csv\")\n\nwith open(\"/kaggle/input/faulty-5a/fault_times.json\") as f:\n    fault_times = set(json.load(f))\n\nA_norm = np.load(\"/kaggle/input/faulty-5a/adjacency.npy\")\nA = torch.tensor(A_norm, dtype=torch.float32)\n\nNODE_IDS = [0, 1, 2, 3, 4, 101]\nNODE_TO_IDX = {n: i for i, n in enumerate(NODE_IDS)}\n\nFAULTY_SENDER = 2\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:19:18.839594Z","iopub.execute_input":"2026-01-27T11:19:18.840388Z","iopub.status.idle":"2026-01-27T11:19:18.895064Z","shell.execute_reply.started":"2026-01-27T11:19:18.840352Z","shell.execute_reply":"2026-01-27T11:19:18.894112Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"def build_fault_labels(df, fault_times, faulty_sender):\n    labels = []\n\n    for _, row in df.iterrows():\n        fault = int(\n            (row.sender == faulty_sender) and\n            (row.time_index in fault_times)\n        )\n        labels.append(fault)\n\n    df = df.copy()\n    df[\"fault_label\"] = labels\n    return df\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:19:28.687608Z","iopub.execute_input":"2026-01-27T11:19:28.688013Z","iopub.status.idle":"2026-01-27T11:19:28.693756Z","shell.execute_reply.started":"2026-01-27T11:19:28.687982Z","shell.execute_reply":"2026-01-27T11:19:28.692881Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"df = build_fault_labels(\n    df_faulty,\n    fault_times,\n    FAULTY_SENDER\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:19:53.393415Z","iopub.execute_input":"2026-01-27T11:19:53.393730Z","iopub.status.idle":"2026-01-27T11:19:53.475815Z","shell.execute_reply.started":"2026-01-27T11:19:53.393704Z","shell.execute_reply":"2026-01-27T11:19:53.474693Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"df.fault_label.value_counts()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:20:00.667942Z","iopub.execute_input":"2026-01-27T11:20:00.668295Z","iopub.status.idle":"2026-01-27T11:20:00.686123Z","shell.execute_reply.started":"2026-01-27T11:20:00.668267Z","shell.execute_reply":"2026-01-27T11:20:00.685076Z"}},"outputs":[{"execution_count":6,"output_type":"execute_result","data":{"text/plain":"fault_label\n0    1233\n1      20\nName: count, dtype: int64"},"metadata":{}}],"execution_count":6},{"cell_type":"code","source":"df[\"theta_calib\"] = df[\"value\"]\n\n# Probe disagreement\nprobe_diff = (\n    df\n    .pivot_table(\n        index=[\"time_index\", \"sender\"],\n        columns=\"probe\",\n        values=\"value\"\n    )\n    .dropna()\n)\n\nprobe_diff[\"probe_disagreement\"] = (\n    probe_diff.iloc[:, 0] - probe_diff.iloc[:, 1]\n).abs()\n\nprobe_diff = probe_diff.reset_index()[\n    [\"time_index\", \"sender\", \"probe_disagreement\"]\n]\n\ndf = df.merge(\n    probe_diff,\n    on=[\"time_index\", \"sender\"],\n    how=\"left\"\n)\n\n# Temporal change\ndf = df.sort_values([\"sender\", \"time_index\"])\ndf[\"delta_theta\"] = (\n    df.groupby(\"sender\")[\"theta_calib\"]\n      .diff()\n      .fillna(0.0)\n)\n\nFEATURE_COLUMNS = [\n    \"theta_calib\",\n    \"probe_disagreement\",\n    \"delta_theta\"\n]\n\ndf[FEATURE_COLUMNS] = df[FEATURE_COLUMNS].fillna(0.0)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:20:12.952689Z","iopub.execute_input":"2026-01-27T11:20:12.953094Z","iopub.status.idle":"2026-01-27T11:20:13.011924Z","shell.execute_reply.started":"2026-01-27T11:20:12.953051Z","shell.execute_reply":"2026-01-27T11:20:13.011140Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"def build_fault_classification_snapshots(df, feature_cols, label_col):\n    snapshots = []\n\n    for t in sorted(df.time_index.unique()):\n        df_t = df[df.time_index == t]\n\n        x = torch.zeros((len(NODE_IDS), len(feature_cols)))\n        y = torch.zeros(len(NODE_IDS))\n\n        for _, row in df_t.iterrows():\n            idx = NODE_TO_IDX[row.sender]\n\n            x[idx] = torch.tensor(\n                row[feature_cols].to_numpy(dtype=np.float32)\n            )\n\n            y[idx] = float(row[label_col])\n\n        snapshots.append({\n            \"time_index\": t,\n            \"x\": x,\n            \"y\": y\n        })\n\n    return snapshots\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:20:23.900151Z","iopub.execute_input":"2026-01-27T11:20:23.900531Z","iopub.status.idle":"2026-01-27T11:20:23.907580Z","shell.execute_reply.started":"2026-01-27T11:20:23.900502Z","shell.execute_reply":"2026-01-27T11:20:23.906580Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"snapshots = build_fault_classification_snapshots(\n    df,\n    FEATURE_COLUMNS,\n    \"fault_label\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:20:34.199292Z","iopub.execute_input":"2026-01-27T11:20:34.199651Z","iopub.status.idle":"2026-01-27T11:20:34.907042Z","shell.execute_reply.started":"2026-01-27T11:20:34.199621Z","shell.execute_reply":"2026-01-27T11:20:34.905812Z"}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"snapshots[0][\"x\"].shape, snapshots[0][\"y\"].shape\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:20:41.611264Z","iopub.execute_input":"2026-01-27T11:20:41.612477Z","iopub.status.idle":"2026-01-27T11:20:41.619434Z","shell.execute_reply.started":"2026-01-27T11:20:41.612349Z","shell.execute_reply":"2026-01-27T11:20:41.618265Z"}},"outputs":[{"execution_count":10,"output_type":"execute_result","data":{"text/plain":"(torch.Size([6, 3]), torch.Size([6]))"},"metadata":{}}],"execution_count":10},{"cell_type":"code","source":"class FaultDetectionGNN(nn.Module):\n    def __init__(self, in_dim, hidden_dim=16):\n        super().__init__()\n        self.fc1 = nn.Linear(in_dim, hidden_dim)\n        self.fc2 = nn.Linear(hidden_dim, 1)\n\n    def forward(self, x, A):\n        h = torch.matmul(A, x)\n        h = F.relu(self.fc1(h))\n        logits = self.fc2(h).squeeze()\n        return logits\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:20:52.296544Z","iopub.execute_input":"2026-01-27T11:20:52.296884Z","iopub.status.idle":"2026-01-27T11:20:52.303865Z","shell.execute_reply.started":"2026-01-27T11:20:52.296857Z","shell.execute_reply":"2026-01-27T11:20:52.302795Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"def train_fault_detector(\n    model,\n    snapshots,\n    A,\n    epochs=50,\n    lr=1e-3,\n    pos_weight=10.0\n):\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n    loss_fn = nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor(pos_weight)\n    )\n\n    for epoch in range(epochs):\n        losses = []\n\n        for snap in snapshots:\n            optimizer.zero_grad()\n\n            logits = model(snap[\"x\"], A)\n            loss = loss_fn(logits, snap[\"y\"])\n\n            loss.backward()\n            optimizer.step()\n\n            losses.append(loss.item())\n\n        if epoch % 10 == 0:\n            print(\n                f\"Epoch {epoch:03d} | Loss: {np.mean(losses):.4f}\"\n            )\n\n    return model\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:21:01.148904Z","iopub.execute_input":"2026-01-27T11:21:01.149324Z","iopub.status.idle":"2026-01-27T11:21:01.156632Z","shell.execute_reply.started":"2026-01-27T11:21:01.149291Z","shell.execute_reply":"2026-01-27T11:21:01.155598Z"}},"outputs":[],"execution_count":12},{"cell_type":"code","source":"model_fd = FaultDetectionGNN(\n    in_dim=len(FEATURE_COLUMNS)\n)\n\nmodel_fd = train_fault_detector(\n    model_fd,\n    snapshots,\n    A,\n    epochs=50,\n    pos_weight=10.0\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:21:12.823149Z","iopub.execute_input":"2026-01-27T11:21:12.823535Z","iopub.status.idle":"2026-01-27T11:21:24.169047Z","shell.execute_reply.started":"2026-01-27T11:21:12.823506Z","shell.execute_reply":"2026-01-27T11:21:24.167783Z"}},"outputs":[{"name":"stdout","text":"Epoch 000 | Loss: 0.7566\nEpoch 010 | Loss: 0.2135\nEpoch 020 | Loss: 0.2032\nEpoch 030 | Loss: 0.1929\nEpoch 040 | Loss: 0.1827\n","output_type":"stream"}],"execution_count":13},{"cell_type":"code","source":"def predict_faults(model, snapshots, A):\n    model.eval()\n    records = []\n\n    with torch.no_grad():\n        for snap in snapshots:\n            logits = model(snap[\"x\"], A)\n            probs = torch.sigmoid(logits)\n\n            for i, node in enumerate(NODE_IDS):\n                records.append([\n                    snap[\"time_index\"],\n                    node,\n                    float(probs[i])\n                ])\n\n    return pd.DataFrame(\n        records,\n        columns=[\"time_index\", \"sender\", \"fault_prob\"]\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:21:26.395872Z","iopub.execute_input":"2026-01-27T11:21:26.396397Z","iopub.status.idle":"2026-01-27T11:21:26.403284Z","shell.execute_reply.started":"2026-01-27T11:21:26.396365Z","shell.execute_reply":"2026-01-27T11:21:26.402068Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"df_pred = predict_faults(model_fd, snapshots, A)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:21:33.353825Z","iopub.execute_input":"2026-01-27T11:21:33.354152Z","iopub.status.idle":"2026-01-27T11:21:33.378218Z","shell.execute_reply.started":"2026-01-27T11:21:33.354126Z","shell.execute_reply":"2026-01-27T11:21:33.377287Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"df_eval = df_pred.merge(\n    df[[\"time_index\", \"sender\", \"fault_label\"]],\n    on=[\"time_index\", \"sender\"]\n)\n\ny_true = df_eval.fault_label.values\ny_score = df_eval.fault_prob.values\ny_pred = (y_score > 0.5).astype(int)\n\nprecision, recall, f1, _ = precision_recall_fscore_support(\n    y_true, y_pred, average=\"binary\", zero_division=0\n)\n\nauc = roc_auc_score(y_true, y_score)\n\nprint({\n    \"precision\": precision,\n    \"recall\": recall,\n    \"f1\": f1,\n    \"roc_auc\": auc\n})\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:21:40.091580Z","iopub.execute_input":"2026-01-27T11:21:40.091945Z","iopub.status.idle":"2026-01-27T11:21:40.117994Z","shell.execute_reply.started":"2026-01-27T11:21:40.091914Z","shell.execute_reply":"2026-01-27T11:21:40.116642Z"}},"outputs":[{"name":"stdout","text":"{'precision': 0.0, 'recall': 0.0, 'f1': 0.0, 'roc_auc': np.float64(0.6114152473641524)}\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"from sklearn.metrics import precision_recall_curve\nimport matplotlib.pyplot as plt\nprecision_curve, recall_curve, thresholds = precision_recall_curve(\n    y_true, y_score\n)\n\nplt.figure(figsize=(6,4))\nplt.plot(recall_curve, precision_curve)\nplt.xlabel(\"Recall\")\nplt.ylabel(\"Precision\")\nplt.title(\"Precision–Recall Curve (Option B)\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:22:56.809804Z","iopub.execute_input":"2026-01-27T11:22:56.810311Z","iopub.status.idle":"2026-01-27T11:22:57.025899Z","shell.execute_reply.started":"2026-01-27T11:22:56.810280Z","shell.execute_reply":"2026-01-27T11:22:57.024529Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":18},{"cell_type":"code","source":"f1_scores = 2 * (precision_curve * recall_curve) / (precision_curve + recall_curve + 1e-8)\nbest_idx = np.argmax(f1_scores)\n\nprint({\n    \"best_f1\": f1_scores[best_idx],\n    \"precision\": precision_curve[best_idx],\n    \"recall\": recall_curve[best_idx],\n    \"threshold\": thresholds[best_idx]\n})\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-27T11:23:11.890592Z","iopub.execute_input":"2026-01-27T11:23:11.890933Z","iopub.status.idle":"2026-01-27T11:23:11.897674Z","shell.execute_reply.started":"2026-01-27T11:23:11.890903Z","shell.execute_reply":"2026-01-27T11:23:11.896569Z"}},"outputs":[{"name":"stdout","text":"{'best_f1': np.float64(0.27397259876149377), 'precision': np.float64(0.18867924528301888), 'recall': np.float64(0.5), 'threshold': np.float64(0.1607656329870224)}\n","output_type":"stream"}],"execution_count":19},{"cell_type":"markdown","source":"Option B (Supervised Fault Detection GNN) — Frozen Results\n\nApproach:\nGraph Neural Network trained for binary fault classification using\nexplicit fault labels and node-level features.\n\nResults:\nROC-AUC ≈ 0.61 indicates improved fault ranking over unsupervised methods.\nBest achievable F1 ≈ 0.27 at recall ≈ 0.5 and precision ≈ 0.19.\n\nInterpretation:\nWhile supervision enables partial discrimination, substantial overlap\nbetween faulty and normal feature distributions remains.\nThreshold-based detection is unreliable due to weak separability.\n\nConclusion:\nSupervised GNNs improve fault awareness but are insufficient for\nrobust fault detection under structured, adversarial faults.\nThis option is frozen.\n","metadata":{}},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}