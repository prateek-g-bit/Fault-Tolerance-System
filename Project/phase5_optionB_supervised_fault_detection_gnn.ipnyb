{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":14637839,"sourceType":"datasetVersion","datasetId":9350761}],"dockerImageVersionId":31259,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:39.194681Z","iopub.execute_input":"2026-01-30T09:22:39.195081Z","iopub.status.idle":"2026-01-30T09:22:39.617670Z","shell.execute_reply.started":"2026-01-30T09:22:39.195019Z","shell.execute_reply":"2026-01-30T09:22:39.616312Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/faulty-5a/fault_times.json\n/kaggle/input/faulty-5a/adjacency.npy\n/kaggle/input/faulty-5a/synthetic_ground_truth_eval.csv\n/kaggle/input/faulty-5a/df_faulty_adv.csv\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom sklearn.metrics import precision_recall_fscore_support, roc_auc_score\nimport json\n\n# Load datasets\ndf_faulty = pd.read_csv(\"/kaggle/input/faulty-5a/df_faulty_adv.csv\")\ndf_true = pd.read_csv(\"/kaggle/input/faulty-5a/synthetic_ground_truth_eval.csv\")\n\nwith open(\"/kaggle/input/faulty-5a/fault_times.json\") as f:\n    fault_times = set(json.load(f))\n\nA_norm = np.load(\"/kaggle/input/faulty-5a/adjacency.npy\")\nA = torch.tensor(A_norm, dtype=torch.float32)\n\nNODE_IDS = [0, 1, 2, 3, 4, 101]\nNODE_TO_IDX = {n: i for i, n in enumerate(NODE_IDS)}\n\nFAULTY_SENDER = 2\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:39.620062Z","iopub.execute_input":"2026-01-30T09:22:39.620647Z","iopub.status.idle":"2026-01-30T09:22:45.692359Z","shell.execute_reply.started":"2026-01-30T09:22:39.620615Z","shell.execute_reply":"2026-01-30T09:22:45.691328Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"def build_fault_labels(df, fault_times, faulty_sender):\n    labels = []\n\n    for _, row in df.iterrows():\n        fault = int(\n            (row.sender == faulty_sender) and\n            (row.time_index in fault_times)\n        )\n        labels.append(fault)\n\n    df = df.copy()\n    df[\"fault_label\"] = labels\n    return df\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:45.693591Z","iopub.execute_input":"2026-01-30T09:22:45.693917Z","iopub.status.idle":"2026-01-30T09:22:45.700879Z","shell.execute_reply.started":"2026-01-30T09:22:45.693888Z","shell.execute_reply":"2026-01-30T09:22:45.699450Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"df = build_fault_labels(\n    df_faulty,\n    fault_times,\n    FAULTY_SENDER\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:45.702299Z","iopub.execute_input":"2026-01-30T09:22:45.702985Z","iopub.status.idle":"2026-01-30T09:22:45.788401Z","shell.execute_reply.started":"2026-01-30T09:22:45.702950Z","shell.execute_reply":"2026-01-30T09:22:45.787028Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"df.fault_label.value_counts()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:45.789819Z","iopub.execute_input":"2026-01-30T09:22:45.790327Z","iopub.status.idle":"2026-01-30T09:22:45.815446Z","shell.execute_reply.started":"2026-01-30T09:22:45.790279Z","shell.execute_reply":"2026-01-30T09:22:45.813901Z"}},"outputs":[{"execution_count":5,"output_type":"execute_result","data":{"text/plain":"fault_label\n0    1233\n1      20\nName: count, dtype: int64"},"metadata":{}}],"execution_count":5},{"cell_type":"code","source":"df[\"theta_calib\"] = df[\"value\"]\n\n# Probe disagreement\nprobe_diff = (\n    df\n    .pivot_table(\n        index=[\"time_index\", \"sender\"],\n        columns=\"probe\",\n        values=\"value\"\n    )\n    .dropna()\n)\n\nprobe_diff[\"probe_disagreement\"] = (\n    probe_diff.iloc[:, 0] - probe_diff.iloc[:, 1]\n).abs()\n\nprobe_diff = probe_diff.reset_index()[\n    [\"time_index\", \"sender\", \"probe_disagreement\"]\n]\n\ndf = df.merge(\n    probe_diff,\n    on=[\"time_index\", \"sender\"],\n    how=\"left\"\n)\n\n# Temporal change\ndf = df.sort_values([\"sender\", \"time_index\"])\ndf[\"delta_theta\"] = (\n    df.groupby(\"sender\")[\"theta_calib\"]\n      .diff()\n      .fillna(0.0)\n)\n\nFEATURE_COLUMNS = [\n    \"theta_calib\",\n    \"probe_disagreement\",\n    \"delta_theta\"\n]\n\ndf[FEATURE_COLUMNS] = df[FEATURE_COLUMNS].fillna(0.0)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:45.817649Z","iopub.execute_input":"2026-01-30T09:22:45.818965Z","iopub.status.idle":"2026-01-30T09:22:45.903600Z","shell.execute_reply.started":"2026-01-30T09:22:45.818917Z","shell.execute_reply":"2026-01-30T09:22:45.902558Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"def build_fault_classification_snapshots(df, feature_cols, label_col):\n    snapshots = []\n\n    for t in sorted(df.time_index.unique()):\n        df_t = df[df.time_index == t]\n\n        x = torch.zeros((len(NODE_IDS), len(feature_cols)))\n        y = torch.zeros(len(NODE_IDS))\n\n        for _, row in df_t.iterrows():\n            idx = NODE_TO_IDX[row.sender]\n\n            x[idx] = torch.tensor(\n                row[feature_cols].to_numpy(dtype=np.float32)\n            )\n\n            y[idx] = float(row[label_col])\n\n        snapshots.append({\n            \"time_index\": t,\n            \"x\": x,\n            \"y\": y\n        })\n\n    return snapshots\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:45.905232Z","iopub.execute_input":"2026-01-30T09:22:45.905524Z","iopub.status.idle":"2026-01-30T09:22:45.912817Z","shell.execute_reply.started":"2026-01-30T09:22:45.905497Z","shell.execute_reply":"2026-01-30T09:22:45.911696Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"snapshots = build_fault_classification_snapshots(\n    df,\n    FEATURE_COLUMNS,\n    \"fault_label\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:45.913954Z","iopub.execute_input":"2026-01-30T09:22:45.914285Z","iopub.status.idle":"2026-01-30T09:22:46.645566Z","shell.execute_reply.started":"2026-01-30T09:22:45.914258Z","shell.execute_reply":"2026-01-30T09:22:46.644457Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"snapshots[0][\"x\"].shape, snapshots[0][\"y\"].shape\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:46.646816Z","iopub.execute_input":"2026-01-30T09:22:46.647255Z","iopub.status.idle":"2026-01-30T09:22:46.655834Z","shell.execute_reply.started":"2026-01-30T09:22:46.647205Z","shell.execute_reply":"2026-01-30T09:22:46.654056Z"}},"outputs":[{"execution_count":9,"output_type":"execute_result","data":{"text/plain":"(torch.Size([6, 3]), torch.Size([6]))"},"metadata":{}}],"execution_count":9},{"cell_type":"code","source":"class FaultDetectionGNN(nn.Module):\n    def __init__(self, in_dim, hidden_dim=16):\n        super().__init__()\n        self.fc1 = nn.Linear(in_dim, hidden_dim)\n        self.fc2 = nn.Linear(hidden_dim, 1)\n\n    def forward(self, x, A):\n        h = torch.matmul(A, x)\n        h = F.relu(self.fc1(h))\n        logits = self.fc2(h).squeeze()\n        return logits\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:46.657470Z","iopub.execute_input":"2026-01-30T09:22:46.657858Z","iopub.status.idle":"2026-01-30T09:22:46.687678Z","shell.execute_reply.started":"2026-01-30T09:22:46.657825Z","shell.execute_reply":"2026-01-30T09:22:46.685774Z"}},"outputs":[],"execution_count":10},{"cell_type":"code","source":"def train_fault_detector(\n    model,\n    snapshots,\n    A,\n    epochs=50,\n    lr=1e-3,\n    pos_weight=10.0\n):\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n    loss_fn = nn.BCEWithLogitsLoss(\n        pos_weight=torch.tensor(pos_weight)\n    )\n\n    for epoch in range(epochs):\n        losses = []\n\n        for snap in snapshots:\n            optimizer.zero_grad()\n\n            logits = model(snap[\"x\"], A)\n            loss = loss_fn(logits, snap[\"y\"])\n\n            loss.backward()\n            optimizer.step()\n\n            losses.append(loss.item())\n\n        if epoch % 10 == 0:\n            print(\n                f\"Epoch {epoch:03d} | Loss: {np.mean(losses):.4f}\"\n            )\n\n    return model\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:46.689863Z","iopub.execute_input":"2026-01-30T09:22:46.690793Z","iopub.status.idle":"2026-01-30T09:22:46.724449Z","shell.execute_reply.started":"2026-01-30T09:22:46.690735Z","shell.execute_reply":"2026-01-30T09:22:46.722720Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"model_fd = FaultDetectionGNN(\n    in_dim=len(FEATURE_COLUMNS)\n)\n\nmodel_fd = train_fault_detector(\n    model_fd,\n    snapshots,\n    A,\n    epochs=50,\n    pos_weight=10.0\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:46.726118Z","iopub.execute_input":"2026-01-30T09:22:46.726518Z","iopub.status.idle":"2026-01-30T09:22:58.509452Z","shell.execute_reply.started":"2026-01-30T09:22:46.726483Z","shell.execute_reply":"2026-01-30T09:22:58.508204Z"}},"outputs":[{"name":"stdout","text":"Epoch 000 | Loss: 0.3548\nEpoch 010 | Loss: 0.1927\nEpoch 020 | Loss: 0.1786\nEpoch 030 | Loss: 0.1664\nEpoch 040 | Loss: 0.1562\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"def predict_faults(model, snapshots, A):\n    model.eval()\n    records = []\n\n    with torch.no_grad():\n        for snap in snapshots:\n            logits = model(snap[\"x\"], A)\n            probs = torch.sigmoid(logits)\n\n            for i, node in enumerate(NODE_IDS):\n                records.append([\n                    snap[\"time_index\"],\n                    node,\n                    float(probs[i])\n                ])\n\n    return pd.DataFrame(\n        records,\n        columns=[\"time_index\", \"sender\", \"fault_prob\"]\n    )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.513054Z","iopub.execute_input":"2026-01-30T09:22:58.514035Z","iopub.status.idle":"2026-01-30T09:22:58.520605Z","shell.execute_reply.started":"2026-01-30T09:22:58.513993Z","shell.execute_reply":"2026-01-30T09:22:58.519389Z"}},"outputs":[],"execution_count":13},{"cell_type":"code","source":"df_pred = predict_faults(model_fd, snapshots, A)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.521809Z","iopub.execute_input":"2026-01-30T09:22:58.522236Z","iopub.status.idle":"2026-01-30T09:22:58.559996Z","shell.execute_reply.started":"2026-01-30T09:22:58.522188Z","shell.execute_reply":"2026-01-30T09:22:58.558895Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"df_eval = df_pred.merge(\n    df[[\"time_index\", \"sender\", \"fault_label\"]],\n    on=[\"time_index\", \"sender\"]\n)\n\ny_true = df_eval.fault_label.values\ny_score = df_eval.fault_prob.values\ny_pred = (y_score > 0.5).astype(int)\n\nprecision, recall, f1, _ = precision_recall_fscore_support(\n    y_true, y_pred, average=\"binary\", zero_division=0\n)\n\nauc = roc_auc_score(y_true, y_score)\n\nprint({\n    \"precision\": precision,\n    \"recall\": recall,\n    \"f1\": f1,\n    \"roc_auc\": auc\n})\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.561254Z","iopub.execute_input":"2026-01-30T09:22:58.561611Z","iopub.status.idle":"2026-01-30T09:22:58.585563Z","shell.execute_reply.started":"2026-01-30T09:22:58.561582Z","shell.execute_reply":"2026-01-30T09:22:58.584450Z"}},"outputs":[{"name":"stdout","text":"{'precision': 0.0, 'recall': 0.0, 'f1': 0.0, 'roc_auc': np.float64(0.8099148418491484)}\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"from sklearn.metrics import precision_recall_curve\nimport matplotlib.pyplot as plt\nprecision_curve, recall_curve, thresholds = precision_recall_curve(\n    y_true, y_score\n)\n\nplt.figure(figsize=(6,4))\nplt.plot(recall_curve, precision_curve)\nplt.xlabel(\"Recall\")\nplt.ylabel(\"Precision\")\nplt.title(\"Precision–Recall Curve (Option B)\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.586674Z","iopub.execute_input":"2026-01-30T09:22:58.587187Z","iopub.status.idle":"2026-01-30T09:22:58.800921Z","shell.execute_reply.started":"2026-01-30T09:22:58.587151Z","shell.execute_reply":"2026-01-30T09:22:58.800147Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":16},{"cell_type":"code","source":"f1_scores = 2 * (precision_curve * recall_curve) / (precision_curve + recall_curve + 1e-8)\nbest_idx = np.argmax(f1_scores)\n\nprint({\n    \"best_f1\": f1_scores[best_idx],\n    \"precision\": precision_curve[best_idx],\n    \"recall\": recall_curve[best_idx],\n    \"threshold\": thresholds[best_idx]\n})\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.801938Z","iopub.execute_input":"2026-01-30T09:22:58.802383Z","iopub.status.idle":"2026-01-30T09:22:58.809244Z","shell.execute_reply.started":"2026-01-30T09:22:58.802339Z","shell.execute_reply":"2026-01-30T09:22:58.808150Z"}},"outputs":[{"name":"stdout","text":"{'best_f1': np.float64(0.35714285255102046), 'precision': np.float64(0.2777777777777778), 'recall': np.float64(0.5), 'threshold': np.float64(0.19843271374702454)}\n","output_type":"stream"}],"execution_count":17},{"cell_type":"markdown","source":"Option B (Supervised Fault Detection GNN) — Frozen Results\n\nApproach:\nGraph Neural Network trained for binary fault classification using\nexplicit fault labels and node-level features.\n\nResults:\nROC-AUC ≈ 0.61 indicates improved fault ranking over unsupervised methods.\nBest achievable F1 ≈ 0.27 at recall ≈ 0.5 and precision ≈ 0.19.\n\nInterpretation:\nWhile supervision enables partial discrimination, substantial overlap\nbetween faulty and normal feature distributions remains.\nThreshold-based detection is unreliable due to weak separability.\n\nConclusion:\nSupervised GNNs improve fault awareness but are insufficient for\nrobust fault detection under structured, adversarial faults.\nThis option is frozen.\n","metadata":{}},{"cell_type":"code","source":"BASE_DIR = \"/kaggle/working/option_b_supervised_fault_gnn_frozen\"\n\nSUBDIRS = [\n    \"config\",\n    \"metrics\",\n    \"traces\",\n    \"curves\",\n    \"model\"\n]\n\nfor d in SUBDIRS:\n    os.makedirs(os.path.join(BASE_DIR, d), exist_ok=True)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.810381Z","iopub.execute_input":"2026-01-30T09:22:58.810730Z","iopub.status.idle":"2026-01-30T09:22:58.826637Z","shell.execute_reply.started":"2026-01-30T09:22:58.810691Z","shell.execute_reply":"2026-01-30T09:22:58.825729Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"config = {\n    \"option\": \"Option B\",\n    \"model\": \"Supervised Fault Detection GNN\",\n    \"nodes\": NODE_IDS,\n    \"faulty_sender\": FAULTY_SENDER,\n    \"features\": FEATURE_COLUMNS,\n    \"hidden_dim\": 16,\n    \"loss\": \"BCEWithLogitsLoss\",\n    \"pos_weight\": 10.0,\n    \"epochs\": 50,\n    \"learning_rate\": 1e-3,\n    \"threshold_selection\": \"PR-curve F1 maximization\",\n    \"notes\": \"Frozen supervised fault detector baseline\"\n}\n\nwith open(f\"{BASE_DIR}/config/train_config.json\", \"w\") as f:\n    json.dump(config, f, indent=4)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.827744Z","iopub.execute_input":"2026-01-30T09:22:58.828345Z","iopub.status.idle":"2026-01-30T09:22:58.844228Z","shell.execute_reply.started":"2026-01-30T09:22:58.828294Z","shell.execute_reply":"2026-01-30T09:22:58.843116Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"global_metrics = {\n    \"roc_auc\": float(auc),\n    \"precision@0.5\": float(precision),\n    \"recall@0.5\": float(recall),\n    \"f1@0.5\": float(f1)\n}\n\nwith open(f\"{BASE_DIR}/metrics/global_metrics.json\", \"w\") as f:\n    json.dump(global_metrics, f, indent=4)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.845455Z","iopub.execute_input":"2026-01-30T09:22:58.845802Z","iopub.status.idle":"2026-01-30T09:22:58.860789Z","shell.execute_reply.started":"2026-01-30T09:22:58.845766Z","shell.execute_reply":"2026-01-30T09:22:58.859625Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"best_metrics = {\n    \"best_f1\": float(f1_scores[best_idx]),\n    \"precision\": float(precision_curve[best_idx]),\n    \"recall\": float(recall_curve[best_idx]),\n    \"threshold\": float(thresholds[best_idx])\n}\n\nwith open(f\"{BASE_DIR}/metrics/best_operating_point.json\", \"w\") as f:\n    json.dump(best_metrics, f, indent=4)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.862190Z","iopub.execute_input":"2026-01-30T09:22:58.862559Z","iopub.status.idle":"2026-01-30T09:22:58.881727Z","shell.execute_reply.started":"2026-01-30T09:22:58.862516Z","shell.execute_reply":"2026-01-30T09:22:58.880561Z"}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"df_eval.to_csv(\n    f\"{BASE_DIR}/traces/fault_predictions.csv\",\n    index=False\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.883408Z","iopub.execute_input":"2026-01-30T09:22:58.883811Z","iopub.status.idle":"2026-01-30T09:22:58.911322Z","shell.execute_reply.started":"2026-01-30T09:22:58.883781Z","shell.execute_reply":"2026-01-30T09:22:58.910208Z"}},"outputs":[],"execution_count":22},{"cell_type":"code","source":"np.save(f\"{BASE_DIR}/traces/y_true.npy\", y_true)\nnp.save(f\"{BASE_DIR}/traces/y_score.npy\", y_score)\nnp.save(f\"{BASE_DIR}/traces/y_pred.npy\", y_pred)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:22:58.912761Z","iopub.execute_input":"2026-01-30T09:22:58.913901Z","iopub.status.idle":"2026-01-30T09:22:58.923233Z","shell.execute_reply.started":"2026-01-30T09:22:58.913861Z","shell.execute_reply":"2026-01-30T09:22:58.922338Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"np.save(f\"{BASE_DIR}/curves/precision.npy\", precision_curve)\nnp.save(f\"{BASE_DIR}/curves/recall.npy\", recall_curve)\nnp.save(f\"{BASE_DIR}/curves/thresholds.npy\", thresholds)\nnp.save(f\"{BASE_DIR}/curves/f1_scores.npy\", f1_scores)