us.idle":"2026-01-30T09:34:40.470983Z","shell.execute_reply.started":"2026-01-30T09:34:40.324707Z","shell.execute_reply":"2026-01-30T09:34:40.469699Z"}},"outputs":[{"name":"stdout","text":"Fault-Tolerance-System\tid_ed25519.pub\nid_ed25519\t\toption_b_supervised_fault_gnn_frozen\n","output_type":"stream"}],"execution_count":36},{"cell_type":"code","source":"!ls /kaggle/working | grep ipynb\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:35:11.823781Z","iopub.execute_input":"2026-01-30T09:35:11.824598Z","iopub.status.idle":"2026-01-30T09:35:11.988822Z","shell.execute_reply.started":"2026-01-30T09:35:11.824556Z","shell.execute_reply":"2026-01-30T09:35:11.987134Z"}},"outputs":[],"execution_count":37},{"cell_type":"code","source":"%cd /kaggle/working/Fault-Tolerance-System\n\n!git status\n!git add .\n!git commit -m \"Freeze Option B: supervised fault detection GNN baseline\"\n!GIT_SSH_COMMAND=\"ssh -i /kaggle/working/id_ed25519 -o StrictHostKeyChecking=no\" \\\ngit push origin main\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-30T09:35:31.302541Z","iopub.execute_input":"2026-01-30T09:35:31.302975Z","iopub.status.idle":"2026-01-30T09:35:33.539191Z","shell.execute_reply.started":"2026-01-30T09:35:31.302935Z","shell.execute_reply":"2026-01-30T09:35:33.537814Z"}},"outputs":[{"name":"stdout","text":"/kaggle/working/Fault-Tolerance-System\nOn branch main\nYour branch is up to date with 'origin/main'.\n\nUntracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n\t\u001b[31moption_b_supervised_fault_gnn_frozen/\u001b[m\n\nnothing added to commit but untracked files present (use \"git add\" to track)\n[main 0fd03ae] Freeze Option B: supervised fault detection GNN baseline\n 14 files changed, 1295 insertions(+)\n create mode 100644 option_b_supervised_fault_gnn_frozen/FROZEN.txt\n create mode 100644 option_b_supervised_fault_gnn_frozen/config/adjacency.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/config/train_config.json\n create mode 100644 option_b_supervised_fault_gnn_frozen/curves/f1_scores.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/curves/precision.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/curves/recall.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/curves/thresholds.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/metrics/best_operating_point.json\n create mode 100644 option_b_supervised_fault_gnn_frozen/metrics/global_metrics.json\n create mode 100644 option_b_supervised_fault_gnn_frozen/model/fault_detection_gnn.pt\n create mode 100644 option_b_supervised_fault_gnn_frozen/traces/fault_predictions.csv\n create mode 100644 option_b_supervised_fault_gnn_frozen/traces/y_pred.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/traces/y_score.npy\n create mode 100644 option_b_supervised_fault_gnn_frozen/traces/y_true.npy\nWarning: Permanently added 'github.com' (ED25519) to the list of known hosts.\nEnumerating objects: 23, done.\nCounting objects: 100% (23/23), done.\nDelta compression using up to 4 threads\nCompressing objects: 100% (22/22), done.\nWriting objects: 100% (22/22), 10.03 KiB | 2.51 MiB/s, done.\nTotal 22 (delta 2), reused 1 (delta 0), pack-reused 0\nremote: Resolving deltas: 100% (2/2), completed with 1 local object.\u001b[K\nTo github.com:prateek-g-bit/Fault-Tolerance-System.git\n   715dda6..0fd03ae  main -> main\n","output_type":"stream"}],"execution_count":38},{"cell_type":"markdown","source":"A fault state is defined as a persistent, latent regime in which a node’s behavior deviates from normal system dynamics and cannot be explained by short-term temporal fluctuations or measurement noise.\n\nOption B failed because, although supervised classification improved fault ranking, it treated faults as independent binary events, leading to unstable predictions and unreliable thresholding under strong class overlap.\n\nThe missing signal is temporal regime consistency: Option B lacks a mechanism to model fault onset, persistence, and recovery as a continuous state rather than isolated detections.\n\nOption C introduces an explicit latent fault state, learned through temporal modeling, that enforces consistency across time and captures fault dynamics as a regime change.\n\nThis fault state is then used to condition downstream prediction, enabling the model to distinguish between normal and faulty regimes while preserving normal-operation performance.","metadata":{}},{"cell_type":"code","source":"import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nclass FaultStateGRU(nn.Module):\n    \"\"\"\n    GRU-based latent fault state model.\n    Outputs P(fault_t | history).\n    \"\"\"\n\n    def __init__(\n        self,\n        input_dim: int,\n        hidden_dim: int = 32,\n        num_layers: int = 1,\n        dropout: float = 0.0\n    ):\n        super().__init__()\n\n        self.gru = nn.GRU(\n            input_size=input_dim,\n            hidden_size=hidden_dim,\n            num_layers=num_layers,\n            batch_first=True,\n            dropout=dropout if num_layers > 1 else 0.0\n        )\n\n        self.fault_head = nn.Linear(hidden_dim, 1)\n\n    def forward(self, x, h0=None):\n        \"\"\"\n        x: Tensor of shape (B, T, F)\n        h0: Optional initial hidden state\n\n        returns:\n            fault_logits: (B, T)\n            fault_probs:  (B, T)\n            hidden:       (B, T, H)\n        \"\"\"\n        hidden, hT = self.gru(x, h0)          # (B, T, H)\n        logits = self.fault_head(hidden)      # (B, T, 1)\n        logits = logits.squeeze(-1)            # (B, T)\n\n        probs = torch.sigmoid(logits)\n\n        return logits, probs, hidden\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def temporal_smoothness_loss(fault_probs):\n    \"\"\"\n    Penalizes rapid fault ↔ normal oscillations.\n\n    fault_probs: (B, T)\n    \"\"\"\n    return torch.mean(torch.abs(fault_probs[:, 1:] - fault_probs[:, :-1]))\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def fault_state_loss(\n    logits,\n    targets,\n    smoothness_weight=0.1,\n    pos_weight=10.0\n):\n    \"\"\"\n    logits:  (B, T)\n    targets: (B, T) ∈ {0,1}\n    \"\"\"\n\n    bce = F.binary_cross_entropy_with_logits(\n        logits,\n        targets,\n        pos_weight=torch.tensor(pos_weight, device=logits.device)\n    )\n\n    probs = torch.sigmoid(logits)\n    smooth = temporal_smoothness_loss(probs)\n\n    return bce + smoothness_weight * smooth\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def train_fault_state_model(\n    model,\n    dataloader,\n    epochs=30,\n    lr=1e-3,\n    smoothness_weight=0.1,\n    pos_weight=10.0,\n    device=\"cuda\" if torch.cuda.is_available() else \"cpu\"\n):\n    model.to(device)\n    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n\n    for epoch in range(epochs):\n        model.train()\n        losses = []\n\n        for x, y in dataloader:\n            x = x.to(device)   # (B, T, F)\n            y = y.to(device)   # (B, T)\n\n            optimizer.zero_grad()\n\n            logits, probs, _ = model(x)\n            loss = fault_state_loss(\n                logits,\n                y,\n                smoothness_weight=smoothness_weight,\n                pos_weight=pos_weight\n            )\n\n            loss.backward()\n            optimizer.step()\n\n            losses.append(loss.item())\n\n        print(\n            f\"Epoch {epoch:03d} | \"\n            f\"Loss: {sum(losses)/len(losses):.4f}\"\n        )\n\n    return model\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}